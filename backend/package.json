{
  "name": "jazamart-backend",
  "version": "5.1.0",
  "private": true,
  "main": "server.js",
  "scripts": {"start": "node server.js", "db:init": "node db-init.js", "db:check": "node -e \"require('dotenv').config(); const {Pool}=require('pg'); const {checkDatabase,printReport}=require('./db-check'); const pool=new Pool({connectionString:process.env.DATABASE_URL,ssl:process.env.DATABASE_SSL==='true'?{rejectUnauthorized:false}:false}); checkDatabase(pool).then(r=>{printReport(r); process.exitCode=r.ok?0:1}).catch(e=>{console.error(e);process.exitCode=1}).finally(()=>pool.end())\""},
  "engines": {"node": ">=20"},
  "dependencies": {"bcryptjs":"2.4.3","cors":"2.8.5","dotenv":"16.4.7","express":"4.21.2","jsonwebtoken":"9.0.2","pg":"8.13.1"}
}
