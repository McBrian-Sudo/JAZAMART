{
  "name": "jazamart",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix backend install --no-audit --no-fund && npm --prefix frontend install --no-audit --no-fund",
    "backend": "npm --prefix backend start",
    "frontend": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "db:check": "npm --prefix backend run db:check",
    "db:init": "npm --prefix backend run db:init",
    "start": "npm --prefix backend start",
    "check": "npm --prefix backend run db:check && npm --prefix frontend run build",
    "docker:build": "docker build -t jazamart .",
    "docker:run": "docker run --env-file backend/.env -p 5000:5000 jazamart"
  },
  "engines": {"node": ">=20"}
}
